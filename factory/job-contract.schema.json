{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EdenExperiments/agentic-software-factory/raw/main/factory/job-contract.schema.json",
  "title": "FactoryJobContract",
  "description": "Contract for an opt-in factory job. The dispatcher that would consume this schema is not implemented yet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "planPath",
    "acceptanceCriteria",
    "targetPaths",
    "verificationCommand"
  ],
  "properties": {
    "planPath": {
      "type": "string",
      "minLength": 1,
      "description": "Path to a saved Plan Mode plan under .cursor/plans/"
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "targetPaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verificationCommand": {
      "type": "string",
      "minLength": 1
    }
  }
}
